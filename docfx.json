{
  "metadata": [
    {
      "src": [
        {
          "src": "DocfxLab/src/RailwayControl",
          "files": [
            "RailwayControl.csproj"
          ]
        }
      ],
      "dest": "api",
      "disableGitFeatures": false,
      "disableDefaultFilter": false
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "toc.yml",
          "*.md"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "RailwayControl API",
      "_appTitle": "Документация",
      "_enableSearch": true,
      "_enableNewTab": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/Arkada-new/DocfxLab",
        "branch": "main"
      }
    }
  }
}
